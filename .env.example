# ---------------------------------------------------------------------------
# Huss Huss Slop — environment
# Copy to .env for local dev, or paste these into Railway → Variables.
# ---------------------------------------------------------------------------

# Port (Railway usually injects PORT itself; 8080 is the default)
PORT=8080

# Where the JSON database + downloaded videos live.
# On Railway, mount a volume at /app/data if you want likes/comments to survive
# redeploys. Without a volume everything is ephemeral (which is fine for a
# cache, less fine for comments).
DATA_DIR=./data
# CACHE_DIR=./data/cache

# Max disk used by downloaded MP4s (MB). Oldest videos are evicted first.
CACHE_MAX_MB=1400

# Preferred / fallback vertical resolution. The downloader automatically drops
# to FALLBACK_HEIGHT when the link looks slower than SLOW_KBPS.
MAX_HEIGHT=720
FALLBACK_HEIGHT=480
SLOW_KBPS=350
SLOW_GRACE_MS=12000

# yt-dlp worker count. Keep at 1 on a 1 GB / 2 vCPU box.
DOWNLOAD_CONCURRENCY=1
DOWNLOAD_TIMEOUT_MS=240000

# ---------------------------------------------------------------------------
# YouTube auth
# ---------------------------------------------------------------------------
# Option A (preferred): paste the FULL contents of a Netscape cookies.txt
# exported from a logged-in YouTube session. Newlines/tabs matter; Railway
# supports multi-line values.
# YT_COOKIE="# Netscape HTTP Cookie File
# .youtube.com	TRUE	/	TRUE	...
# ..."
#
# Option B: a path to a cookies.txt already on disk (e.g. on a volume).
# YT_COOKIE_FILE=/app/data/cookies.txt
#
# If neither is set the app falls back to yt-dlp's visionOS player client,
# which often works from datacenter IPs without cookies.
# YT_PLAYER_CLIENT=visionos
#
# Path to the yt-dlp binary (the Docker image installs it globally).
# YTDLP_PATH=/usr/local/bin/yt-dlp
#
# JS runtime used by yt-dlp for YouTube signature solving. Set to "off" to
# disable. In Docker this is Node.
# YT_JS_RUNTIME=node

# Seconds with no visitor (or only hidden tabs) before background downloads
# pause. They resume on the next visit. 0 disables idling.
# IDLE_AFTER_SECONDS=120
