# ---------------------------------------------------------------------------
# Huss Huss Slop — environment
# Copy to .env for local dev, or paste these into Railway → Variables.
# ---------------------------------------------------------------------------

# Port (Railway usually injects PORT itself; 8080 is the default)
PORT=8080

# Where the JSON mirror + downloaded videos live.
# On Railway, mount a volume at /app/data if you want the video cache to survive
# redeploys. Likes/comments/share codes go to MongoDB when configured below.
DATA_DIR=./data
# CACHE_DIR=./data/cache

# MongoDB keeps profiles, comments and feed share codes across redeploys.
# Railway's MongoDB plugin injects MONGO_URL automatically — nothing to paste.
# Other hosts: set MONGODB_URI (or MONGO_URI). Leave blank to use local JSON only.
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=huss_huss_slop

# Redis caches feed builds, share codes and marketplace reads. The durable DB
# above stays the source of truth and is read at every boot. Railway's Redis
# plugin injects REDIS_URL; without it the app falls back to an in-process cache.
# REDIS_URL=redis://localhost:6379

# Max disk used by downloaded MP4s (MB). Oldest videos are evicted first.
# Railway's free volume is 500 MB, so leave headroom for db.json.
CACHE_MAX_MB=450

# Preferred / fallback vertical resolution. The downloader automatically drops
# to FALLBACK_HEIGHT when the link looks slower than SLOW_KBPS.
MAX_HEIGHT=720
FALLBACK_HEIGHT=480
SLOW_KBPS=350
SLOW_GRACE_MS=12000

# yt-dlp worker count. Keep at 1 on a 1 GB / 2 vCPU box.
DOWNLOAD_CONCURRENCY=1
# Parallel DASH fragments per download. Higher downloads faster but uses more
# bandwidth/CPU; 8 is a good balance for a small Railway box.
DOWNLOAD_FRAGMENTS=8
DOWNLOAD_TIMEOUT_MS=240000

# Optional password for the in-app admin panel (⚙ in the top bar) that sends
# live banner messages to every connected viewer. If unset, a random password
# is generated at boot and printed to the logs.
# ADMIN_TOKEN=change-me

# ---------------------------------------------------------------------------
# YouTube auth
# ---------------------------------------------------------------------------
# Option A (preferred): paste the FULL contents of a Netscape cookies.txt
# exported from a logged-in YouTube session. Newlines/tabs matter; Railway
# supports multi-line values.
# YT_COOKIE="# Netscape HTTP Cookie File
# .youtube.com	TRUE	/	TRUE	...
# ..."
#
# Option B: a path to a cookies.txt already on disk (e.g. on a volume).
# YT_COOKIE_FILE=/app/data/cookies.txt
#
# If neither is set the app falls back to yt-dlp's visionOS player client,
# which often works from datacenter IPs without cookies.
# YT_PLAYER_CLIENT=visionos
#
# Path to the yt-dlp binary (the Docker image installs it globally).
# YTDLP_PATH=/usr/local/bin/yt-dlp
#
# JS runtime used by yt-dlp for YouTube signature solving. Set to "off" to
# disable. In Docker this is Node.
# YT_JS_RUNTIME=node

# Seconds with no visitor (or only hidden tabs) before background downloads
# pause. They resume on the next visit. 0 disables idling.
# IDLE_AFTER_SECONDS=120
